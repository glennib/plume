# name: test/shim/visualize.test
# description: The VISUALIZE clause of the grammar shim, its activation per connection, and the plume_* settings
# group: [plume]

# make test_shim points PLUME_SHIM at the built shim and hands the runner the core.
require-env PLUME_SHIM

require plume

statement ok
LOAD '${PLUME_SHIM}'

# The grammar is registered, but a connection has to switch it on. Until then VISUALIZE is an
# ordinary word, here the implicit alias of 1, and the error is at what follows it.
query T
SELECT name FROM duckdb_grammar_extensions()
----
plume_visualize

statement error
SELECT 1 VISUALIZE chart()
----
Parser Error: syntax error at or near "chart"

statement ok
SET active_grammar_extensions = ['plume_visualize']

# <query> VISUALIZE <targets> is SELECT <targets> FROM (<query>).
query T
SELECT i FROM range(5) r(i) VISUALIZE chart().draw_series(line_series(i, i * i))::VARCHAR
----
CHART(line, 1 series, 5 points)

query T
SELECT i FROM range(5) r(i) VISUALISE chart().draw_series(point_series(i, i))::VARCHAR
----
CHART(point, 1 series, 5 points)

# The target list can hold several expressions and aliases, and the query a CTE, ORDER BY and LIMIT.
query IT
WITH t AS (SELECT i, i % 2 AS k FROM range(10) r(i))
SELECT * FROM t ORDER BY i DESC LIMIT 6
VISUALIZE count(*) AS n, chart().draw_series(line_series(i, i, key := k))::VARCHAR AS c
----
6	CHART(line, 2 series, 6 points)

# GROUP BY belongs to the query; the chart expression aggregates its rows.
query TT
SELECT section, count(*) AS n
FROM (VALUES ('news'), ('news'), ('sport')) v(section)
GROUP BY section
VISUALIZE list(section ORDER BY section)::VARCHAR, chart().draw_series(histogram_vertical(section, n))::VARCHAR
----
[news, sport]	CHART(histogram, 1 series, 2 points)

# Output functions apply as in any chart expression.
query T
SELECT i FROM range(3) r(i) VISUALIZE chart().draw_series(line_series(i, i)).to_svg()[1:26]
----
<svg width="640" height="4

# VISUALIZE is a statement suffix, not part of a subquery.
statement error
SELECT * FROM (SELECT 1 AS i VISUALIZE chart())
----
Parser Error

# EXPLAIN and PREPARE take a statement, so they take one with VISUALIZE.
statement ok
EXPLAIN SELECT i FROM range(3) r(i) VISUALIZE chart().draw_series(line_series(i, i))

statement ok
PREPARE p AS SELECT i FROM range(4) r(i) VISUALIZE chart().draw_series(line_series(i, i))::VARCHAR

query T
EXECUTE p
----
CHART(line, 1 series, 4 points)

# While the grammar is active, VISUALIZE and VISUALISE are reserved words: fine as an explicit
# alias, quoted as an identifier.
query I
SELECT 1 AS visualize
----
1

query I
SELECT "visualize" FROM (SELECT 2 AS "visualize")
----
2

statement error
SELECT visualise FROM (SELECT 2 AS visualise)
----
Parser Error

# RESET switches the grammar off again for this connection.
statement ok
RESET active_grammar_extensions

statement error
SELECT 1 VISUALIZE chart()
----
Parser Error: syntax error at or near "chart"

# The plume_* settings: NULL (unset) means the process-wide setting, which plume_get reports.
query TTT
SELECT current_setting('plume_viewer'), current_setting('plume_wait'), current_setting('plume_max_show')
----
NULL	NULL	NULL

statement error
SET plume_viewer = 'kitty'
----
Invalid Input Error: plume_viewer: expected one of 'auto', 'terminal', 'window', 'browser', got 'kitty'

statement ok
SET plume_viewer = 'Browser'

query TT
SELECT current_setting('plume_viewer'), plume_get('viewer')
----
browser	auto

statement error
SET plume_wait = 'maybe'
----
Could not convert string 'maybe' to BOOL

statement ok
SET plume_wait = true

statement error
SET plume_max_show = -1
----
out of range for the destination type UINT64

statement ok
SET GLOBAL plume_max_show = 3

query I
SELECT current_setting('plume_max_show')
----
3

# With plume_max_show = 0, show() shows nothing, so it succeeds where no viewer could work.
statement ok
SET plume_max_show = 0

query T
SELECT chart().show()::VARCHAR FROM range(3)
----
CHART(empty)
CHART(empty)
CHART(empty)

statement ok
RESET plume_max_show

query TTT
SELECT current_setting('plume_viewer'), current_setting('plume_wait'), current_setting('plume_max_show')
----
browser	true	NULL
