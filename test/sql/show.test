# name: test/sql/show.test
# description: show() argument checks, NULL handling and the settings, without showing anything
# group: [plume]

require plume

# Nothing in this file may reach a viewer: every call below is NULL, fails before showing, or
# runs with max_show at 0. What the viewers do is tested by scripts/check_show.py.

query T
SELECT plume_get('max_show')
----
10

query T
SELECT plume_set('max_show', 0)
----
0

# NULL in, NULL out; a NULL chart is not counted.
query T
SELECT (NULL::CHART).show() IS NULL
----
true

query T
SELECT typeof((NULL::CHART).show())
----
CHART

# The chart comes back unchanged, and nothing is shown with max_show at 0.
query TT
SELECT c.show()::BLOB = c::BLOB, c.show()::VARCHAR
FROM (SELECT chart().caption('squares').draw_series(line_series(i, i * i)) AS c FROM range(10) r(i))
----
true	CHART(line, 1 series, 10 points, caption 'squares')

query I
SELECT count(chart().show(width := 100, height := 100)) FROM range(20)
----
20

# A NULL named argument means its default.
query T
SELECT chart().show(viewer := NULL, wait := NULL, width := NULL, height := NULL) IS NOT NULL
----
true

query T
SELECT chart().show(viewer := 'Browser', wait := true, width := 8192, height := 1) IS NOT NULL
----
true

# Constant arguments are checked at bind time.
statement error
SELECT chart().show(viewer := 'kitty')
----
Binder Error: show: invalid value 'kitty' for 'viewer': expected one of 'auto', 'terminal', 'window', 'browser'

statement error
SELECT chart().show(width := 0)
----
Binder Error: show: chart size must be between 1 and 8192 px per side, got 0x480

statement error
SELECT chart().show(height := 8193)
----
Binder Error: show: chart size must be between 1 and 8192 px per side, got 640x8193

statement error
SELECT chart().show(bogus := 1)
----
Binder Error

# Column arguments are checked on every row, including rows past the cap.
statement error
SELECT chart().show(viewer := v) FROM (VALUES ('window'), ('sixel')) t(v)
----
Invalid Input Error: show: invalid value 'sixel' for 'viewer'

statement error
SELECT chart().show(width := w) FROM (VALUES (10), (-1)) t(w)
----
Invalid Input Error: show: chart size must be between 1 and 8192 px per side, got -1x480

# A string literal casts to CHART without the BLOB cast's check, so show() decodes it itself.
statement error
SELECT ('abc'::CHART).show()
----
Invalid Input Error: show:

# The settings: keys and values are case-insensitive, values may be any type, and the result is
# the new value as plume_get reports it.
query TTT
SELECT plume_set('WAIT', ' On '), plume_set('viewer', 'Terminal'), plume_set('max_show', 3)
----
true	terminal	3

query TTT
SELECT plume_get('wait'), plume_get('viewer'), plume_get('Max_Show')
----
true	terminal	3

query TT
SELECT plume_set('wait', false), plume_set('viewer', 'auto')
----
false	auto

query T
SELECT plume_set('max_show', NULL) IS NULL
----
true

query T
SELECT plume_get('max_show')
----
3

statement error
SELECT plume_set('colour', 'red')
----
Invalid Input Error: plume_set: unknown plume setting 'colour'; the settings are 'viewer', 'wait' and 'max_show'

statement error
SELECT plume_get('colour')
----
Invalid Input Error: plume_get: unknown plume setting 'colour'

statement error
SELECT plume_set('wait', 'maybe')
----
Invalid Input Error: plume_set: invalid value 'maybe' for 'wait': expected true or false (also 1/0, yes/no, on/off)

statement error
SELECT plume_set('max_show', -1)
----
Invalid Input Error: plume_set: invalid value '-1' for 'max_show': expected a non-negative integer

statement error
SELECT plume_set('viewer', 'sixel')
----
Invalid Input Error: plume_set: invalid value 'sixel' for 'viewer'

# A failed plume_set leaves the value as it was.
query T
SELECT plume_get('max_show')
----
3

query T
SELECT plume_set('max_show', '0')
----
0
